# Per-developer Claude Code settings — never commit
.claude/settings.local.json

# Hook runtime state — append-only logs, counters, kill switches
.claude/inbox/.hook-log
.claude/inbox/.fire-counter
.claude/inbox/.disabled
.claude/inbox/.recall-counter
.claude/inbox/.recall-disabled
.claude/inbox/.turn-count

# Live session inbox — derived view, regenerated each session by inbox-update skill
wiki/inbox/_session.md

# Inbox archives — per-machine crash-safety net for /wiki-digest, not source of truth
wiki/inbox/_archive/

# Codebase-crawler scratch — inventory/graph/concepts JSON for /wiki-code-crawler
_docgen/
_docgen/**

# macOS Finder metadata
.DS_Store
**/.DS_Store

.agents
.agents/**

